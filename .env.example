# Template for .env - copy it with `cp .env.example .env`, then fill it in.
# .env holds secrets: it is gitignored and never leaves the machine it's on.
# This template holds none, so it is committed.
#
# The server's two installations each have their own .env, sharing nothing
# (docs/testing.md). The comments below say what differs between them.

# The bot's token. Use the "Dragonhoard Beta" application's token on beta and
# the "Dragonhoard" application's on production - never the same one on both.
# Discord Developer Portal -> the application -> Bot -> Reset Token
# On your own computer, a placeholder is enough to run the tests.
DISCORD_BOT_TOKEN=

# Where the database lives. Leave this commented out to use the default,
# data/dragonhoard.db (production). Beta uncomments it, so wiping beta's
# database never touches live player data.
# Don't leave it uncommented but empty: an empty path is not the default -
# SQLite then keeps a temporary database that is deleted when the bot stops.
# DATABASE_PATH=data/dragonhoard-beta.db

# Beta only: your test server's ID - put the number right after the "=" sign.
# Right-click the server in Discord -> Copy Server ID. (Needs Developer Mode on:
# User Settings -> Advanced -> Developer Mode.)
#
# With this set, slash commands sync to that one server INSTANTLY instead of
# taking up to an hour to propagate globally. This is the single biggest
# quality-of-life win when testing command changes, so do fill it in on beta.
# Leave it empty on production, which syncs globally.
#
# Must be a plain number or empty - config.py calls int() on it.
DEV_GUILD_ID=

# Tells the bot it's running as the "Dragonhoard Beta" Discord application,
# not the live one. data/emoji.py reads this to pick each custom emoji's
# beta id instead of its live id, since the two applications don't share
# uploaded emoji. Uncomment it on beta; production leaves it commented out
# and defaults to "live". Don't leave it uncommented but empty - config.py
# refuses to start unless it is "live", "beta" or absent.
# BOT_ENVIRONMENT=beta
